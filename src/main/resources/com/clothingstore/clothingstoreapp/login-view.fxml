<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:id="authRoot"
           fx:controller="com.clothingstore.clothingstoreapp.controller.LoginController"
           styleClass="auth-root"
           stylesheets="@styles.css"
           prefWidth="1200"
           prefHeight="750">

    <ImageView fx:id="backgroundImageView"
               fitWidth="1200"
               fitHeight="750"
               preserveRatio="false"
               smooth="true">
        <image>
            <Image url="@../../../images/12.jpg"/>
        </image>
    </ImageView>

    <Region styleClass="auth-overlay"/>

    <VBox fx:id="loginCard"
          alignment="CENTER" spacing="18"
          styleClass="auth-card"
          maxWidth="360"
          minWidth="360"
          maxHeight="430"
          minHeight="430"
          StackPane.alignment="CENTER">

        <!-- Store name -->
        <VBox alignment="CENTER" spacing="8">

            <Label text="Clothing Store"
                   styleClass="auth-title"/>

            <Label text="Sign in to continue shopping"
                   styleClass="auth-subtitle"/>
        </VBox>

        <!-- Inputs -->
        <VBox spacing="10" minWidth="280" maxWidth="280">

            <Label text="Username" styleClass="helper-text"/>
            <TextField fx:id="usernameField"
                       promptText="Enter your username"
                       styleClass="input-field"/>

            <Label text="Password" styleClass="helper-text"/>
            <PasswordField fx:id="passwordField"
                           promptText="Enter your password"
                           styleClass="input-field"/>

            <CheckBox fx:id="loginAgreementCheckBox"
                      text="I agree to terms and conditions"
                      styleClass="helper-text"/>
        </VBox>

        <!-- Buttons -->
        <HBox alignment="CENTER" spacing="14">
            <Button text="LOGIN"
                    onAction="#handleLogin"
                    prefWidth="125"
                    prefHeight="44"
                    styleClass="button-primary"/>

            <Button text="SIGN UP"
                    onAction="#openRegisterWindow"
                    prefWidth="125"
                    prefHeight="44"
                    styleClass="button-outline"/>
        </HBox>

        <!-- Error -->
        <Label fx:id="messageLabel"
               styleClass="message-error"/>

    </VBox>

</StackPane>
